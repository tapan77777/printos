# Copy to .printos-dev/.env; never overwrite apps/web/.env.
# Fill locally after creating a NEW, EMPTY Supabase project.
PRINTOS_ENVIRONMENT="development"
PRINTOS_DEV_PROJECT_REF="<new-project-reference>"
# Copy the NEW project's session-pooler URI from Connect, port 5432.
# URL-encode the password if needed. Append sslmode=require.
DATABASE_URL="postgresql://postgres.<new-project-reference>:<encoded-new-password>@<copied-pooler-host>:5432/postgres?sslmode=require"
# New DEVELOPMENT-ONLY values; do not reuse or change existing secrets.
SESSION_SECRET=""
OWNER_PASSWORD_HASH=""
# Keep printing disabled. No real printer agent is used for these tests.
AGENT_CREDENTIALS_JSON="[]"
AGENT_TOKEN=""
AGENT_ID=""
AGENT_DEVICE_ID=""
