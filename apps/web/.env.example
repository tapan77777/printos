DATABASE_URL="postgresql://user:password@host:5432/printos"

# Owner login (scrypt hash of the password). Generate with:
#   node apps/web/scripts/hash-password.mjs 'your-password'
OWNER_PASSWORD_HASH=""

# Random 32+ byte hex string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Shared bearer token the local print agent uses to call /api/jobs/*.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
AGENT_TOKEN=""

# Dev switch — when "true" the UI shows "DEV MODE: PAYMENT MOCKED" and jobs
# are created with paymentStatus=NOT_REQUIRED. There is no payment gateway yet.
DEV_PRINT_MODE="true"

# Max upload size in bytes (default 25 MB)
MAX_UPLOAD_BYTES="26214400"
