DATABASE_URL="postgresql://user:password@host:5432/printos"

# Retired global owner login; kept for historical local tooling only. Not accepted by APIs.
# Legacy fixture hash generation:
#   node apps/web/scripts/hash-password.mjs 'your-password'
OWNER_PASSWORD_HASH=""

# Retired legacy HMAC fixture secret; account sessions use BETTER_AUTH_SECRET.
# Historical fixture generation:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Phase 2A legacy agents, restricted to unassigned records and disabled in tenant mode.
# These credentials cannot authorize any new tenant shop.
# JSON array of {id, printerDeviceId, mode: "cups"|"mock", tokenSha256}.
# Configure out of band; never place plaintext tokens in this JSON.
AGENT_CREDENTIALS_JSON="[]"

# Optional single-CUPS-agent compatibility configuration. ALL three values
# must be set together; an unscoped AGENT_TOKEN alone is deliberately denied.
AGENT_ID=""
AGENT_DEVICE_ID=""
AGENT_TOKEN=""

# Dev switch — when "true" the UI shows "DEV MODE: PAYMENT MOCKED" and jobs
# are created with paymentStatus=NOT_REQUIRED. There is no payment gateway yet.
DEV_PRINT_MODE="true"

# Max upload size in bytes (default 25 MB)
MAX_UPLOAD_BYTES="26214400"

# Phase 2E.1: configure ONLY after reviewing/applying the exact tenancy migration.
# No global password fallback. Tenant accounts require verified email and DB sessions.
# PRINTOS_AUTH_MODE="tenant"
# BETTER_AUTH_URL="https://your-approved-printos.example"
# BETTER_AUTH_SECRET="<new high-entropy secret, at least 32 characters>"
# RESEND_API_KEY="<server-only email provider key>"
# AUTH_EMAIL_FROM="PrintOS <accounts@your-verified-domain.example>"
# Leave false unless your hosting proxy OVERWRITES x-real-ip before forwarding.
# Default uses a conservative shared rate-limit bucket rather than trusting client IP headers.
# PRINTOS_TRUST_PROXY="false"

# Phase 2E.2 enrollment stays disabled until its migration is explicitly approved.
PRINTOS_DEVICE_ENROLLMENT="disabled"
# Local auth-only template: config/auth-development.env.example; run npm run auth:check.

# Phase 2E.4: local mode is development-only; production/Vercel fails closed.
# Configure manually only after approved schema + bucket/policy rollout.
PRINTOS_DOCUMENT_STORAGE="local"
SUPABASE_STORAGE_URL=""
# SERVER ONLY: Supabase service-role JWT for Storage. Never NEXT_PUBLIC_ or renderer.
SUPABASE_STORAGE_SECRET_KEY=""
PRINTOS_DOCUMENT_BUCKET="printos-documents"
PRINTOS_DOCUMENT_RETENTION_DAYS="7"
# Scheduled cleanup is disabled until configured explicitly. Use a fresh private token.
PRINTOS_DOCUMENT_CLEANUP="disabled"
CRON_SECRET=""
# Optional reads of original local files on a non-Vercel production installation.
# Vercel always denies this fallback. New production uploads still require cloud.
PRINTOS_LEGACY_LOCAL_READ="disabled"

# Set before building, only after approved public release upload and download verification.
# PRINTOS_WINDOWS_INSTALLER_URL="https://github.com/tapan77777/printos/releases/download/desktop-v0.1.1/PrintOS.Setup.0.1.1.exe"

# Optional sanitized numeric request timings. Never logs SQL or request contents.
# PRINTOS_PERFORMANCE_DIAGNOSTICS="enabled"
