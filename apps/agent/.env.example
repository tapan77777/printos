CUPS_PRINTER_NAME="HP_LaserJet"
PRINTOS_CLOUD_URL="http://localhost:3000"
DEVICE_ID="BOX-001"

# Must match this agent's id and printer scope in the server credential registry.
AGENT_ID="counter-agent"
# Plaintext token stays on this machine; server stores its SHA-256 hash.
AGENT_TOKEN=""

# Durable PRIVATE state directory. Default: ~/.printos-agent/<AGENT_ID>.
# Use a local disk, not a temporary/network/synced folder. Never delete active state.
# AGENT_STATE_DIR="/private/path/printos-agent"

# Initial authorization lease (30,000–300,000 ms). Active attempts are NEVER
# automatically reclaimed. Renewal is permitted only to their original agent.
CLAIM_LEASE_MS="120000"

# Poll interval (ms) for pulling new approved jobs.
POLL_INTERVAL_MS="5000"

# Poll interval (ms) for checking CUPS job completion after lp submission.
CUPS_POLL_INTERVAL_MS="2000"

# Max seconds to wait before requiring reconciliation (not automatic failure/retry).
CUPS_COMPLETION_TIMEOUT_SEC="300"

# Simulation mode. Default "cups" uses lp plus read-only local IPP status queries.
# Set to "mock" to run the simulator: it walks APPROVED -> DOWNLOADING -> PRINTING
# -> COMPLETED (or FAILED) through the same fenced attempt protocol without
# touching CUPS. Simulated jobs are tagged with cupsJobId="SIM-..." and
# simulation=true. The server credential must use mode=mock, bound to a
# simulationOnly printer. When mode=mock, CUPS_PRINTER_NAME is not required.
PRINT_DEVICE_MODE="cups"

# Simulated print latency, in ms, between PRINTING and COMPLETED.
MOCK_PRINT_LATENCY_MS="3000"

# Simulated failure probability (0..1). 0 = always COMPLETED.
MOCK_FAIL_RATE="0"

# If "true", skip the mock's PDF download step (pure offline simulation).
MOCK_SKIP_DOWNLOAD="false"

# Windows: run npm run printers:windows on Windows and select an exact queue.
# Renames, port or driver changes require explicit reselection AFTER active attempts resolve.
# WINDOWS_PRINTER_NAME="Office Printer"
# WINDOWS_PRINTER_IDENTIFIER="<64 lowercase hex characters from discovery>"
# Trusted, operator-qualified Sumatra build supporting ignore-pdf-print-settings,
# paperkind, copies, monochrome/color and simplex/duplexlong. No automatic downloads.
# WINDOWS_SUMATRA_PATH="C:\\PrintOS\\tools\\SumatraPDF.exe"
# WINDOWS_SUMATRA_SHA256="<independently verified SHA256 of that exact executable>"
