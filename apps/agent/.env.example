CUPS_PRINTER_NAME="HP_LaserJet"
PRINTOS_CLOUD_URL="http://localhost:3000"
DEVICE_ID="BOX-001"

# Must match AGENT_TOKEN in apps/web/.env
AGENT_TOKEN=""

# How long a claimed job is leased before another agent could re-claim it (ms).
CLAIM_LEASE_MS="300000"

# Poll interval (ms) for pulling new approved jobs.
POLL_INTERVAL_MS="5000"

# Poll interval (ms) for checking CUPS job completion after lp submission.
CUPS_POLL_INTERVAL_MS="2000"

# Max seconds to wait for CUPS to report completion before marking FAILED.
CUPS_COMPLETION_TIMEOUT_SEC="300"
