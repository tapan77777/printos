{
  "name": "printos-agent",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file=.env --import tsx src/index.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/engine.test.ts tests/adapters.test.ts tests/network.test.ts tests/windows.test.ts",
    "printers:windows": "node --import tsx src/windows-printers.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.5.0",
    "tsx": "^4.16.0",
    "@types/node": "^20.14.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
