# Dependencies
node_modules/
**/node_modules/

# Next.js build output + caches
.next/
**/.next/
out/
**/out/

# Generic build output
dist/
build/
**/dist/
**/build/

# TypeScript incremental build metadata
*.tsbuildinfo
**/*.tsbuildinfo

# Environment files at every depth. Keep only *.example templates.
.env
.env.*
**/.env
**/.env.*
!**/.env.example

# Local uploads / runtime artifacts (never commit customer PDFs)
apps/web/tmp-uploads/
apps/web/tmp-uploads/*

# Prisma generated client (regenerated via `prisma generate`)
apps/web/node_modules/.prisma/

# Logs
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / tool local state (project-local only; keep shared .claude configs if intended)
.DS_Store
**/.DS_Store
.vscode/
.idea/
**/.claude/settings.local.json

# Vitest / Vite caches
.vite/
**/.vite/
